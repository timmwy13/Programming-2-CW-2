public class Main {
    static File salesFile = new File("sales.txt");
    // Store Products
    private static List<Product> products = new ArrayList<>();

    // Main method and GUI
    public static void main(String[] args) {
        System.out.println("Sales file absolute path: " + salesFile.getAbsolutePath());


        JFrame mainMenu = new JFrame("Shop Management System");
        mainMenu.setLayout(new FlowLayout());

        // Ensure the file exists
        try {
            if (!salesFile.exists()) {
                boolean created = salesFile.createNewFile();
                if (created) {
                    System.out.println("sales.txt created successfully.");
                } else {
                    System.out.println("Failed to create sales.txt.");
                }
            } else {
                System.out.println("sales.txt already exists.");
            }
        } catch (IOException e) {
            System.err.println("IOException when checking/creating sales.txt: " + e.getMessage());
            e.printStackTrace();
        }
        
        // View Products Button
        JButton viewProductsButton = new JButton("View Products");
        viewProductsButton.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                JFrame viewProducts = new JFrame("View Products");
                viewProducts.setLayout(new FlowLayout());

                // Add Product Button
                JButton addProductsButton = new JButton("Add Products");
                addProductsButton.addActionListener(new ActionListener() {
                    @Override
                    public void actionPerformed(ActionEvent ev) {
                        JFrame addProducts = new JFrame("Add Products");
                        addProducts.setLayout(new FlowLayout());

                        JPanel inputPanel = new JPanel();
                        JLabel label = new JLabel("Add Product: ");
                        JTextField productField = new JTextField(20);
                        JButton submitButton = new JButton("Submit");

                        inputPanel.add(label);
                        inputPanel.add(productField);
                        inputPanel.add(submitButton);
                        addProducts.add(inputPanel);
                        addProducts.setSize(600, 300);
                        addProducts.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
                        addProducts.setVisible(true);

                        submitButton.addActionListener(submitEvent -> {
                            String productText = productField.getText().trim();
                            if (!productText.isEmpty()) {
                            	products.add(new Product(productText, 0));
                                JOptionPane.showMessageDialog(addProducts, "Product added successfully!");
                                productField.setText("");
                            } else {
                                JOptionPane.showMessageDialog(addProducts, "Error: Product name cannot be empty.");
                            }
                        });
                    }
                });

             // Update Product Button
                JButton updateProductsButton = new JButton("Update Existing Products");
                updateProductsButton.addActionListener(new ActionListener() {
                    @Override
                    public void actionPerformed(ActionEvent ev) {
                        JFrame updateFrame = new JFrame("Update Products");
                        updateFrame.setSize(600, 400);
                        updateFrame.setLayout(new BorderLayout());
                        updateFrame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);

                        String[] columnNames = {"Product Name", "Quantity"};
                        DefaultTableModel model = new DefaultTableModel(columnNames, 0) {
                            @Override
                            public boolean isCellEditable(int row, int column) {
                                return column == 1;
                            }

                            @Override
                            public Class<?> getColumnClass(int columnIndex) {
                                return columnIndex == 1 ? Integer.class : String.class;
                            }
                        };

                        for (Product product : products) {
                            model.addRow(new Object[]{product.getName(), product.getQuantity()});
                        }

                        JTable table = new JTable(model);
                        JScrollPane scrollPane = new JScrollPane(table);
                        updateFrame.add(scrollPane, BorderLayout.CENTER);

                        JButton saveButton = new JButton("Save Updates");
                        saveButton.addActionListener(e -> {
                            for (int i = 0; i < model.getRowCount(); i++) {
                                int updatedQty = (int) model.getValueAt(i, 1);
                                products.get(i).setQuantity(updatedQty);
                            }
                            JOptionPane.showMessageDialog(updateFrame, "Products updated successfully!");
                        });

                        updateFrame.add(saveButton, BorderLayout.SOUTH);
                        updateFrame.setVisible(true);
                    }
                });


                // Delete Product Button
             // Delete Product Button
               JButton deleteProductsButton = new JButton("Remove Products");
                deleteProductsButton.addActionListener(new ActionListener() {
                    @Override
                    public void actionPerformed(ActionEvent ev) {
                        JFrame deleteFrame = new JFrame("Remove Products");
                        deleteFrame.setSize(400, 200);
                        deleteFrame.setLayout(new FlowLayout());
                        deleteFrame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);

                        JPanel inputPanel = new JPanel(new FlowLayout());
                        JComboBox<String> productComboBox = new JComboBox<>();
                        JButton deleteButton = new JButton("Delete");

                        for (Product product : products) {
                            productComboBox.addItem(product.getName());
                        }

                        inputPanel.add(new JLabel("Select Product to Remove: "));
                        inputPanel.add(productComboBox);
                        inputPanel.add(deleteButton);
                        deleteFrame.add(inputPanel);

                        deleteButton.addActionListener(e -> {
                            String selectedProductName = (String) productComboBox.getSelectedItem();
                            if (selectedProductName != null) {
                                products.removeIf(product -> product.getName().equals(selectedProductName));
                                JOptionPane.showMessageDialog(deleteFrame, "Product removed successfully!");
                                deleteFrame.dispose();
                            }
                        });

                        deleteFrame.setVisible(true);
                    }
                });


                viewProducts.add(addProductsButton);
                viewProducts.add(updateProductsButton);
                viewProducts.add(deleteProductsButton);

                viewProducts.setSize(600, 400);
                viewProducts.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
                viewProducts.setVisible(true);
            }
        });

        // Add a sale Button
        JButton salesButton = new JButton("Add Transaction");
        salesButton.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                JFrame addTransaction = new JFrame("Add a Transaction");
                addTransaction.setLayout(new FlowLayout());
                
                JLabel productLabel = new JLabel("Add Product Name: ");
                JTextField productField = new JTextField(20);
                JLabel priceLabel = new JLabel("Add Product Price: ");
                JTextField priceField = new JTextField(10);
                JLabel quantityLabel = new JLabel("Add Sale Quantity: ");
                JTextField quantityField = new JTextField(10);
                JButton submitButton = new JButton("Submit");

                submitButton.addActionListener(submitEvent -> {
                String productName = productField.getText().trim();            
                String price = priceField.getText().trim();            
                String quantity = quantityField.getText().trim();

                if (productName == null ||productName.trim().isEmpty()) {
                   JOptionPane.showMessageDialog(addTransaction, "Product name cannot be empty", "Error",JOptionPane.WARNING_MESSAGE);
                   return;
                }
                
                if (price == null ||price.trim().isEmpty()) {
                   JOptionPane.showMessageDialog(addTransaction, "Product Price cannot be empty", "Error",JOptionPane.WARNING_MESSAGE);
                   return;
                }

                if (quantity == null ||quantity.trim().isEmpty()) {       
                JOptionPane.showMessageDialog(addTransaction, "Product Quantity cannot be empty", "Error",JOptionPane.WARNING_MESSAGE);
                return;
                }
                    
                else {
                    	
                	try (BufferedWriter writer = new BufferedWriter(new FileWriter(salesFile, true))) {
                    writer.write(productName+ ", "+price+ ", "+quantity);        
                    writer.newLine();       
                    writer.flush();
                    
                    // Clear inputs after saving    
                    productField.setText("");       
                    priceField.setText("");      
                    quantityField.setText("");       
                    JOptionPane.showMessageDialog(addTransaction, "Sale added successfully!", "Success", JOptionPane.INFORMATION_MESSAGE);  
                	}
                    	   
                	catch (IOException ex) {    
                		JOptionPane.showMessageDialog(addTransaction, "Error saving sale data!", "Error", JOptionPane.ERROR_MESSAGE);   
                	}
                }
                });
                
                
                addTransaction.add(productLabel);
                addTransaction.add(productField);
                addTransaction.add(priceLabel);
                addTransaction.add(priceField);
                addTransaction.add(quantityLabel);
                addTransaction.add(quantityField);
                addTransaction.add(submitButton);
                addTransaction.setSize(600, 600);
                addTransaction.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
                addTransaction.setVisible(true);
            }
        });

        // Summary Button
        JButton summaryButton = new JButton("Generate Sales Summary Report");
        summaryButton.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                JFrame salesReport = new JFrame("Sales Report");
                salesReport.setLayout(new FlowLayout());
                double totalRevenue = 0.0;
                StringBuilder sales = new StringBuilder();
                
                try (BufferedReader reader = new BufferedReader(new FileReader(salesFile))) {
                    String line;
                    while ((line = reader.readLine()) != null) {
                        String[] saleData = line.split(", ");
                        if (saleData.length==3){
                            double price = Double.parseDouble(saleData[1].trim());
                            int quantity = Integer.parseInt(saleData[2].trim());
                            totalRevenue += price * quantity;
                        }
                        
                        String sale = "Product Name:"+saleData[0]+" | "+"Price:"+saleData[1]+" | "+"Sale Quantity:"+saleData[2]+" | "+"Total Revenue:"+totalRevenue;
                        sales.append(sale).append("\n");
                    
                    }
                } 
                
                catch (IOException ex) {
                    ex.printStackTrace();
                    JOptionPane.showMessageDialog(salesReport, "Error generating sales report!", "Error", JOptionPane.ERROR_MESSAGE);
                }

                if (sales.length() == 0) {
                    JOptionPane.showMessageDialog(salesReport, "No sales available!", "Sales Report", JOptionPane.INFORMATION_MESSAGE);
                }
                else {
                    JOptionPane.showMessageDialog(salesReport, sales.toString(), "Sales Report", JOptionPane.INFORMATION_MESSAGE);
                }
                salesReport.setSize(600, 500);
                salesReport.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
                salesReport.setVisible(true);
            }
        });

        mainMenu.add(viewProductsButton);
        mainMenu.add(salesButton);
        mainMenu.add(summaryButton);
        mainMenu.setSize(600, 300);
        mainMenu.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        mainMenu.setVisible(true);
    }

